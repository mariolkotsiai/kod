{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kernel Overview and Diagnostics - KOD",
  "version": "0.1.0",
  "identifier": "io.github.mariolkotsiai.kod",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420",
             "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [{ "label": "main", "title": "Kernel Overview & Diagnostics - KOD", "width": 1100, "height": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mariol kotsiai",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}